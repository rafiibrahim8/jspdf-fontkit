--- /dev/null
+++ b/packages/jsPDF/src/libs/utf16be.js
@@ -0,0 +1,14 @@
+/**
+ * Encodes a string as the hex digits of a UTF-16BE PDF text string with a
+ * byte order mark, for use as <...> in content streams.
+ *
+ * @param {string} text
+ * @returns {string}
+ */
+export function toUTF16BEHex(text) {
+  var hex = "FEFF";
+  for (var i = 0; i < text.length; i++) {
+    hex += ("0000" + text.charCodeAt(i).toString(16)).slice(-4);
+  }
+  return hex;
+}
