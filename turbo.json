{
    "$schema": "https://turbo.build/schema.json",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**"]
        },
        "dev": {
            "dependsOn": ["build"],
            "persistent": true,
            "cache": false
        },
        "start": {
            "dependsOn": ["build"],
            "persistent": true,
            "cache": true
        }
    }
}
